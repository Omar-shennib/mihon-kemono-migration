+package mihon.feature.migration.list
+
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class KemonoCreatorUrlTest {
+
+    @Test
+    fun `matches creator urls only`() {
+        assertTrue(KEMONO_CREATOR_URL.matches("/patreon/user/17779781"))
+        assertTrue(KEMONO_CREATOR_URL.matches("/fanbox/user/abc123"))
+
+        assertFalse(KEMONO_CREATOR_URL.matches("/patreon/user/17779781/post/1"))
+        assertFalse(KEMONO_CREATOR_URL.matches("/manga/12345"))
+        assertFalse(KEMONO_CREATOR_URL.matches("https://kemono.cr/patreon/user/17779781"))
+    }
+}
