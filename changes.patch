+package mihon.feature.migration.list
+
+import eu.kanade.tachiyomi.source.Source
+import eu.kanade.tachiyomi.source.model.SManga
+import eu.kanade.tachiyomi.source.online.HttpSource
+import kotlinx.coroutines.CancellationException
+
+/** Creator URL used by Kemono-style archives, e.g. `/patreon/user/17779781`. */
+internal val KEMONO_CREATOR_URL = Regex("""/[^/]+/user/[^/]+""")
+
+/**
+ * Kemono-style archives (e.g. Kemono and Pawchive) share creator URLs but show different creator names,
+ * so a title search can't find the entry. Sources built on keiyoushi's KeiSource resolve a URL typed into
+ * search: try the creator's page URL and Pawchive's `/creators/<id>` form, and only trust a result that
+ * points at the exact same creator.
+ */
+internal suspend fun Source.findCreatorByUrl(creatorUrl: String): SManga? {
+    if (!KEMONO_CREATOR_URL.matches(creatorUrl)) return null
+    val baseUrl = (this as? HttpSource)?.baseUrl ?: return null
+    val id = creatorUrl.substringAfterLast('/')
+    return listOf("$baseUrl$creatorUrl", "$baseUrl/creators/$id").firstNotNullOfOrNull { query ->
+        try {
+            getSearchManga(1, query, getFilterList()).mangas.firstOrNull { it.url == creatorUrl }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (_: Exception) {
+            null
+        }
+    }
+}
