+                    found += networkToLocalManga(result.mangas.map { it.toDomainManga(source.id) })
+                    setDialog(Dialog.AddAllLoading(found.size))
+                } while (result.hasNextPage && found.size < ADD_ALL_LIMIT)
+
+                val toAdd = found.distinctBy { it.id }.filterNot { it.favorite }
+                val categories = getCategories()
+                when {
+                    toAdd.isEmpty() -> {
+                        setDialog(null)
+                        addAllEvents.send(AddAllEvent.Added(0))
+                    }
+                    categories.isEmpty() -> addAllToLibrary(toAdd, emptyList())
+                    else -> setDialog(Dialog.AddAllToLibrary(toAdd, categories.mapAsCheckboxState { false }))
+                }
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                setDialog(null)
+                addAllEvents.send(AddAllEvent.Failed(e.message.orEmpty()))
+            }
+        }
+    }
