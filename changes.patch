+/** Sources may record a post's time differently (time zone, precision), so dates within this window match. */
+private val UPLOAD_DATE_TOLERANCE_MS = 1.days.inWholeMilliseconds
+
+/** Post URL shared by Kemono-style archives, e.g. `/patreon/user/17779781/post/148187606`. */
+internal val KEMONO_POST_URL = Regex("""/[^/]+/user/[^/]+/post/[^/]+""")
+
+/**
+ * Maps target chapter id to the matching previous chapter:
+ * 1. Kemono-style post URLs, which are identical across archives, match exactly.
+ * 2. When either side has no post URL: the same normalized name and an upload date within
+ *    [UPLOAD_DATE_TOLERANCE_MS].
+ *    Closest dates are paired first, so same-named posts don't all inherit one post's read state.
+ * Each chapter matches at most once.
+ */
+internal fun matchChapters(targetChapters: List<Chapter>, prevChapters: List<Chapter>): Map<Long, Chapter> {
+    val prevChaptersByPostUrl = prevChapters.filter { KEMONO_POST_URL.matches(it.url) }.associateBy { it.url }
+    val matches = targetChapters
+        .mapNotNull { chapter -> prevChaptersByPostUrl[chapter.url]?.let { chapter.id to it } }
+        .toMap(mutableMapOf())
+    val usedPrevIds = matches.values.mapTo(mutableSetOf()) { it.id }
+
+    val prevChaptersByName = prevChapters.groupBy { it.name.normalizeForMatch() }
+    val candidates = targetChapters
+        .flatMap { chapter ->
+            prevChaptersByName[chapter.name.normalizeForMatch()].orEmpty().map { chapter to it }
+        }
+        // Two different post URLs are two different posts, whatever their names and dates
+        .filterNot { (chapter, prev) -> KEMONO_POST_URL.matches(chapter.url) && KEMONO_POST_URL.matches(prev.url) }
+        .filter { (chapter, prev) -> abs(chapter.dateUpload - prev.dateUpload) <= UPLOAD_DATE_TOLERANCE_MS }
+        .sortedBy { (chapter, prev) -> abs(chapter.dateUpload - prev.dateUpload) }
+
+    for ((chapter, prev) in candidates) {
+        if (chapter.id in matches || prev.id in usedPrevIds) continue
+        matches[chapter.id] = prev
+        usedPrevIds += prev.id
+    }
+    return matches
+}
