@@ -0,0 +1,75 @@
+package mihon.domain.migration.usecases
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.model.Chapter
+
+class NormalizeForMatchTest {
+
+    @Test
+    fun `visually identical names match`() {
+        val expected = "commission for someone (part 2)"
+        listOf(
+            "Commission for Someone (Part 2)",
+            "  Commission for Someone (Part 2)\n",
+            "Commission for  Someone (Part 2)",
+            "Commission for​ Someone (Part 2)",
+            "﻿COMMISSION FOR SOMEONE (PART 2)",
+            "Commission for Someone （Part 2）",
+        ).forEach { assertEquals(expected, it.normalizeForMatch(), it) }
+    }
+
+    @Test
+    fun `different names do not match`() {
+        assertNotEquals("Part 1".normalizeForMatch(), "Part 2".normalizeForMatch())
+    }
+
+    @Test
+    fun `same-named posts match only on the same posted date`() {
+        val day = 86_400_000L
+        fun chapter(id: Long, name: String, date: Long, read: Boolean = false) =
+            Chapter.create().copy(id = id, name = name, dateUpload = date, read = read)
+
+        val prev = listOf(
+            chapter(1, "WIP", 10 * day, read = true),
+            chapter(2, "WIP", 20 * day),
+            chapter(3, "Sketch", 30 * day, read = true),
+            chapter(4, "Old post", 40 * day, read = true),
+        )
+        val target = listOf(
+            chapter(11, "WIP", 11 * day), // a day after the read WIP; must not steal its match
+            chapter(10, "wip ", 10 * day),
+            chapter(12, "WIP", 20 * day + 3_600_000), // same day, different hour
+            chapter(13, "WIP", 50 * day), // no counterpart
+            chapter(14, "Sketch", 30 * day),
+            chapter(15, "Old post", 45 * day), // same name, different date
+        )
+
+        val matches = matchChapters(target, prev)
+
+        assertEquals(mapOf(10L to 1L, 12L to 2L, 14L to 3L), matches.mapValues { it.value.id })
+        assertEquals(listOf(10L, 14L), target.filter { matches[it.id]?.read == true }.map { it.id })
+    }
+
+    @Test
+    fun `identical post urls match regardless of name and date`() {
+        fun chapter(id: Long, url: String, name: String, date: Long, read: Boolean = false) =
+            Chapter.create().copy(id = id, url = url, name = name, dateUpload = date, read = read)
+
+        val prev = listOf(
+            chapter(1, "/patreon/user/17779781/post/148187606", "Old title", 0, read = true),
+            chapter(2, "/patreon/user/17779781/post/2", "WIP", 5_000, read = true),
+            chapter(3, "/chapter/7", "Chapter 7", 9_000, read = true),
+        )
+        val target = listOf(
+            chapter(10, "/patreon/user/17779781/post/148187606", "Renamed title", 999_999_999),
+            chapter(11, "/patreon/user/17779781/post/3", "WIP", 5_000), // different post, same name and date
+            chapter(12, "/chapter/7", "Something else", 123_456_789), // non-post urls never match by url
+        )
+
+        val matches = matchChapters(target, prev)
+
+        assertEquals(mapOf(10L to 1L), matches.mapValues { it.value.id })
+    }
+}
