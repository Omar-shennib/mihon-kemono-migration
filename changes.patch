+private val invisibleChars = Regex("[\\u200B-\\u200D\\u2060\\uFEFF]")
+private val whitespace = Regex("\\s+")
+
+/** NFKC (folds NBSP/full-width forms), drop zero-width chars, collapse whitespace, trim, lowercase. */
+internal fun String.normalizeForMatch(): String =
+    Normalizer.normalize(this, Normalizer.Form.NFKC)
+        .replace(invisibleChars, "")
+        .replace(whitespace, " ")
+        .trim()
+        .lowercase()
